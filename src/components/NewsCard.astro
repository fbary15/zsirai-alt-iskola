---
import type { Hir } from '../lib/util';
import { formatDate, categoryLabel } from '../lib/util';
interface Props { hir: Hir; eager?: boolean }
const { hir, eager = false } = Astro.props;
---
<a class="card news-card" href={`/hirek/${hir.slug}/`}>
  <div class="thumb">
    {hir.cover ? (
      <img src={hir.coverThumb ?? hir.cover} srcset={`${hir.coverThumb ?? hir.cover} 640w, ${hir.cover} 1600w`} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px" alt="" width="640" height="400" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22h16M4 4h16v18H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
    )}
  </div>
  <div class="body">
    <div class="meta">
      <span class={`tag ${hir.category === 'info' ? '' : hir.category === 'archivum' ? 'grey' : 'sun'}`}>{categoryLabel(hir.category)}</span>
      <time datetime={hir.date ?? undefined}>{formatDate(hir.date)}</time>
    </div>
    <h3>{hir.title}</h3>
    {hir.excerpt && <p>{hir.excerpt}</p>}
    <span class="more">Tovább olvasom →</span>
  </div>
</a>
