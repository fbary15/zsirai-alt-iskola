---
interface Props { current: number; total: number; base: string }
const { current, total, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}oldal/${n}/`);
const pages: (number | '…')[] = [];
for (let i = 1; i <= total; i++) {
  if (i === 1 || i === total || Math.abs(i - current) <= 1) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---
{total > 1 && (
  <nav class="pagination" aria-label="Lapozás">
    {current > 1 ? <a href={href(current - 1)} aria-label="Előző oldal">‹</a> : <span class="disabled">‹</span>}
    {pages.map((p) => p === '…' ? <span class="disabled">…</span> : p === current ? <span aria-current="page">{p}</span> : <a href={href(p)}>{p}</a>)}
    {current < total ? <a href={href(current + 1)} aria-label="Következő oldal">›</a> : <span class="disabled">›</span>}
  </nav>
)}
