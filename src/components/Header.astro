---
import Logo from './Logo.astro';
import { nav, KRETA_URL } from '../data/nav';
import { iskola } from '../data/iskola';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<div class="topbar">
  <div class="container topbar-in">
    <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.6 2.6.7a2 2 0 0 1 1.7 2z"/></svg> <a href={iskola.telefonHref}>{iskola.telefon}</a></span>
    <span class="sep">·</span>
    <span>OM azonosító: {iskola.om}</span>
    <span class="sep">·</span>
    <span>{iskola.cim}</span>
  </div>
</div>
<header class="site-header" id="site-header">
  <div class="container header-in">
    <a class="brand" href="/">
      <Logo size={46} />
      <span class="brand-text">
        <strong>Zsirai Általános Iskola</strong>
        <small>Zsira · 1991 óta nyolc évfolyammal</small>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menü">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Fő navigáció" data-lenis-prevent>
      <ul>
        {nav.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            {item.children ? (
              <>
                <a href={item.href} aria-current={isActive(item.href) || item.children.some((c) => isActive(c.href)) ? 'page' : undefined}>{item.label}</a>
                <button class="sub-toggle" aria-expanded="false" aria-label={`${item.label} almenü`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <ul class="sub">
                  {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                </ul>
              </>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
        <li class="cta"><a class="btn btn-sun" href={KRETA_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          KRÉTA e-napló</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .topbar { background: var(--green-900); color: #cfe6d6; font-size: .85rem; font-family: var(--font-head); }
  .topbar-in { display: flex; gap: .6rem; align-items: center; padding: .35rem 0; flex-wrap: wrap; }
  .topbar a { color: #fff; text-decoration: none; }
  .topbar svg { vertical-align: -2px; margin-right: .2rem; }
  .sep { opacity: .4; }
  @media (max-width: 640px) { .topbar span:nth-child(n+4) { display: none; } }

  .site-header { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .header-in { display: flex; align-items: center; gap: 1.5rem; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: .75rem; text-decoration: none; color: var(--green-900); margin-right: auto; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text strong { font-family: var(--font-head); font-size: 1.15rem; font-weight: 700; letter-spacing: -.01em; }
  .brand-text small { font-size: .78rem; color: var(--muted); font-family: var(--font-head); }

  .site-nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .1rem; }
  .site-nav li { position: relative; }
  .site-nav > ul > li > a { display: inline-block; padding: .55rem .8rem; font-family: var(--font-head); font-weight: 600; font-size: .98rem; color: var(--ink); text-decoration: none; border-radius: 8px; }
  .site-nav > ul > li > a:hover, .site-nav > ul > li > a[aria-current] { color: var(--green-700); background: var(--green-50); }
  .site-nav > ul > li.has-sub > a { padding-right: 1.6rem; }
  .sub-toggle { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%); border: 0; background: transparent; padding: .2rem; color: var(--muted); cursor: pointer; display: grid; place-items: center; border-radius: 6px; pointer-events: none; }
  .sub { position: absolute; left: 0; top: calc(100% + 6px); min-width: 250px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); list-style: none; padding: .5rem; margin: 0;
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: .18s ease; }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: .5rem .75rem; border-radius: 8px; text-decoration: none; color: var(--ink); font-size: .95rem; font-weight: 500; }
  .sub a:hover, .sub a[aria-current] { background: var(--green-50); color: var(--green-700); }
  .cta { margin-left: .5rem; }
  .cta .btn { padding: .55rem 1rem; font-size: .92rem; }

  .nav-toggle { display: none; width: 44px; height: 44px; border: 1px solid var(--line); background: #fff; border-radius: 10px; cursor: pointer; flex-direction: column; gap: 5px; align-items: center; justify-content: center; }
  .nav-toggle span { display: block; width: 20px; height: 2px; background: var(--green-900); transition: .2s; }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1080px) {
    .brand-text small { display: none; }
    .nav-toggle { display: flex; }
    .site-nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow-lg); max-height: calc(100vh - 76px); overflow: auto; }
    .site-nav.open { display: block; }
    .site-nav > ul { flex-direction: column; align-items: stretch; padding: .75rem var(--gutter) 1.25rem; gap: .15rem; }
    .site-nav > ul > li > a { display: block; padding: .75rem .75rem; font-size: 1.05rem; }
    .sub-toggle { pointer-events: auto; right: .5rem; top: 4px; transform: none; width: 44px; height: 44px; }
    .sub-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; border-left: 2px solid var(--green-100); border-radius: 0; margin: 0 0 .5rem .9rem; padding: 0 0 0 .5rem; display: none; }
    .has-sub.open .sub { display: block; }
    .cta { margin: .75rem 0 0; }
    .cta .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navEl = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = navEl!.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((b) => {
    b.addEventListener('click', (e) => {
      e.preventDefault();
      const li = b.closest('li')!;
      const open = li.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('.has-sub.open').forEach((li) => li.classList.remove('open'));
  });
</script>
