---
import type { Doc } from '../data/iskola';
interface Props { docs: Doc[] }
const { docs } = Astro.props;
const kind = (href: string) => href.includes('drive.google') ? 'drive' : href.startsWith('http') ? 'ext' : 'pdf';
---
<div class="doc-list">
  {docs.map((d) => {
    const k = kind(d.href);
    return (
      <a class="card doc" href={d.href} target="_blank" rel="noopener">
        <span class={`ico ${k === 'drive' ? 'drive' : ''}`}>{k === 'drive' ? 'DRIVE' : 'PDF'}</span>
        <span>
          <span class="t">{d.cim}</span>
          {d.leiras && <span class="s"><br />{d.leiras}</span>}
          {k === 'drive' && <span class="s"><br />Google Drive megosztás</span>}
          {k === 'ext' && <span class="s"><br />Régi honlapon tárolt fájl</span>}
        </span>
        <svg class="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
      </a>
    );
  })}
</div>
