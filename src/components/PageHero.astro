---
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[]; eyebrow?: string }
const { title, lead, crumbs = [], eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <nav class="crumbs" aria-label="Morzsamenü">
      <a href="/">Címlap</a>
      {crumbs.map((c) => (<><span aria-hidden="true">›</span>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
      <span aria-hidden="true">›</span><span>{title}</span>
    </nav>
    {eyebrow && <span class="eyebrow" style="color:var(--sun)">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
