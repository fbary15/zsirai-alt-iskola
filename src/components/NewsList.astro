---
import NewsCard from './NewsCard.astro';
import Pagination from './Pagination.astro';
import type { Hir } from '../lib/util';
interface Props { items: Hir[]; page: number; total: number; base: string }
const { items, page, total, base } = Astro.props;
---
<div class="grid grid-3">
  {items.map((h, i) => <NewsCard hir={h} eager={page === 1 && i < 3} />)}
</div>
<Pagination current={page} total={total} base={base} />
