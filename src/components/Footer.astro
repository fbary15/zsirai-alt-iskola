---
import Logo from './Logo.astro';
import { iskola } from '../data/iskola';
import { iskolankMenu, informaciokMenu, KRETA_URL } from '../data/nav';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="col brand-col">
      <a class="brand" href="/"><Logo size={40} /> <strong>Zsirai Általános Iskola</strong></a>
      <p>{iskola.szlogen}. Nyolc évfolyamos általános iskola, 1991 óta jelenlegi formájában.</p>
      <address>
        <div>{iskola.cim}</div>
        <div>Telefon: <a href={iskola.telefonHref}>{iskola.telefon}</a> · Fax: {iskola.fax}</div>
        <div>OM azonosító: {iskola.om}</div>
      </address>
    </div>
    <div class="col">
      <h4>Iskolánk</h4>
      <ul>{iskolankMenu.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </div>
    <div class="col">
      <h4>Információk</h4>
      <ul>{informaciokMenu.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </div>
    <div class="col">
      <h4>Hasznos</h4>
      <ul>
        <li><a href="/hirek/">Hírek</a></li>
        <li><a href="/archivum/">Archívum</a></li>
        <li><a href="/galeria/">Galéria</a></li>
        <li><a href="/elerhetosegeink/">Elérhetőségeink</a></li>
        <li><a href={KRETA_URL} target="_blank" rel="noopener">KRÉTA elektronikus ellenőrző</a></li>
      </ul>
      <div class="badges">
        <img src="/images/de4d03d9_penz7.webp" alt="Iskolánk Pénz7 iskola" width="120" loading="lazy" />
        <img src="/images/79c39a6c_h1.webp" alt="Határtalanul program" width="120" loading="lazy" />
      </div>
    </div>
  </div>
  <div class="container bottom">
    <span>{iskola.copyright} · {year}</span>
    <span>Fenntartó: {iskola.fenntarto.nev}</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--green-900); color: #cfe6d6; margin-top: 3rem; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 2rem; padding: 3.5rem 0 2.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; color: #fff; text-decoration: none; font-family: var(--font-head); font-size: 1.1rem; margin-bottom: 1rem; }
  .brand-col p { max-width: 38ch; }
  address { font-style: normal; display: grid; gap: .2rem; font-size: .95rem; }
  .site-footer a { color: #fff; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; color: var(--sun); }
  h4 { color: #fff; font-family: var(--font-head); font-size: .85rem; text-transform: uppercase; letter-spacing: .12em; margin: .4rem 0 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; font-size: .97rem; }
  .badges { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .badges img { background: #fff; border-radius: 8px; padding: 6px; }
  .bottom { border-top: 1px solid rgba(255,255,255,.12); padding: 1.1rem 0; font-size: .85rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; opacity: .85; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
