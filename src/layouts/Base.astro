---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { iskola } from '../data/iskola';

interface Props {
  title?: string; description?: string; image?: string | null;
  type?: 'website' | 'article'; published?: string | null; noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  crumbs?: { label: string; href: string }[];
}
const {
  title, description = 'A Zsirai Általános Iskola hivatalos honlapja – hírek, tanév rendje, dokumentumok, elérhetőségek.',
  image, type = 'website', published, noindex = false, jsonLd = [], crumbs,
} = Astro.props;
const fullTitle = title ? `${title} – ${iskola.nev}` : `${iskola.nev} – Köszöntjük weblapunkon`;
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(image ?? '/images/dc9fb91b_iskolakep.webp', origin);

const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org', '@type': 'School', '@id': `${origin}#school`, name: iskola.nev, telephone: '+36 99 543015',
    address: { '@type': 'PostalAddress', streetAddress: 'Fő utca 37.', postalCode: '9476', addressLocality: 'Zsira', addressCountry: 'HU' },
    url: String(origin), logo: new URL('/icons/icon-512.png', origin), image: ogImage,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: iskola.nev, url: String(origin), inLanguage: 'hu' },
  ...jsonLd,
];
if (crumbs && crumbs.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Címlap', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, origin) })),
  });
}
---
<!doctype html>
<html lang="hu" class="lenis">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
  <meta name="author" content={iskola.nev} />
  <meta name="geo.region" content="HU-GS" />
  <meta name="geo.placename" content="Zsira" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#1f6b3a" />
  <meta name="color-scheme" content="light" />
  <meta name="format-detection" content="telephone=yes" />
  <meta property="og:site_name" content={iskola.nev} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="hu_HU" />
  <meta property="og:image" content={ogImage} />
  {type === 'article' && published && <meta property="article:published_time" content={published} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip-link" href="#main">Ugrás a tartalomra</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <button class="to-top" id="to-top" aria-label="Vissza a tetejére" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
  </button>
</body>
</html>

<script>
  import Lenis from 'lenis';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let lenis: Lenis | null = null;

  if (!reduce) {
    lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1, touchMultiplier: 1.5, smoothWheel: true, syncTouch: false });
    (window as any).lenis = lenis;
    const raf = (t: number) => { lenis!.raf(t); requestAnimationFrame(raf); };
    requestAnimationFrame(raf);
  }

  const scrollTo = (target: HTMLElement | number, offset = -84) => {
    if (lenis) lenis.scrollTo(target, { offset, duration: 1.1 });
    else if (typeof target === 'number') window.scrollTo({ top: target, behavior: 'smooth' });
    else window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY + offset, behavior: 'smooth' });
  };

  // Belső horgonyok (#...) simán görgetnek
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a || a.getAttribute('href') === '#') return;
    const el = document.querySelector<HTMLElement>(a.getAttribute('href')!);
    if (!el) return;
    e.preventDefault();
    scrollTo(el);
    history.pushState(null, '', a.getAttribute('href'));
  });

  // "Vissza a tetejére" gomb
  const top = document.getElementById('to-top')!;
  const onScroll = () => { top.hidden = window.scrollY < 600; };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  top.addEventListener('click', () => scrollTo(0, 0));

  // Finom megjelenés görgetéskor
  const items = document.querySelectorAll<HTMLElement>('.card, .section-head, .prose, .timeline > li, .doc, .album, .masonry > a');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    items.forEach((el, i) => {
      el.classList.add('reveal');
      el.style.setProperty('--d', `${Math.min((i % 6) * 60, 300)}ms`);
      io.observe(el);
    });
    // ami már a képernyőn van betöltéskor, azonnal jelenjen meg
    requestAnimationFrame(() => items.forEach((el) => { if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-in'); }));
  }
</script>
