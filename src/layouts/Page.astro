---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import SideNav from '../components/SideNav.astro';
interface Props {
  title: string; lead?: string; description?: string;
  section?: 'iskolank' | 'informaciok' | 'none';
  crumbs?: { label: string; href?: string }[];
  wide?: boolean;
}
const { title, lead, description, section = 'none', crumbs, wide = false } = Astro.props;
const autoCrumbs = crumbs ?? (section === 'iskolank' ? [{ label: 'Iskolánk', href: '/altalanos-ismerteto/' }] : section === 'informaciok' ? [{ label: 'Információk', href: '/tanev-rendje/' }] : []);
---
<Base title={title} description={description ?? lead} crumbs={[...autoCrumbs.filter((c) => c.href).map((c) => ({ label: c.label, href: c.href! })), { label: title, href: Astro.url.pathname }]}>
  <PageHero title={title} lead={lead} crumbs={autoCrumbs} />
  <div class="container page-body">
    {wide ? (
      <slot />
    ) : (
      <div class="layout-side">
        <div><slot /></div>
        <SideNav section={section} />
      </div>
    )}
  </div>
</Base>
