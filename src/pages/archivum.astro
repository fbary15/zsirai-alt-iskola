---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { archivHirek, formatDate, tanev } from '../lib/util';

const groups = new Map<string, typeof archivHirek>();
for (const h of archivHirek) {
  const k = tanev(h.date) || 'Ismeretlen';
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(h);
}
---
<Base title="Archívum" description="A Zsirai Általános Iskola korábbi híreinek, beszámolóinak archívuma.">
  <PageHero title="Archívum" lead={`Korábbi tanévek bejegyzései, tanévkezdési tájékoztatói és beszámolói. ${archivHirek.length} archivált bejegyzés.`} />
  <div class="container page-body narrow">
    {[...groups.entries()].map(([ev, items]) => (
      <section class="year">
        <h2>{ev}. tanév</h2>
        <ul class="list-clean stack">
          {items.map((h) => (
            <li class="card row">
              <time datetime={h.date ?? undefined}>{formatDate(h.date, { short: true })}</time>
              <a href={`/hirek/${h.slug}/`}>{h.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="center" style="margin-top:2.5rem"><a class="btn btn-outline" href="/hirek/">Aktuális hírek</a></p>
  </div>
</Base>
<style>
  .narrow { margin-inline: auto; }
  .year { margin-bottom: 2.5rem; }
  .year h2 { font-size: 1.3rem; color: var(--green-700); border-bottom: 2px solid var(--green-100); padding-bottom: .4rem; }
  .row { display: flex; gap: 1.25rem; align-items: baseline; padding: .8rem 1.1rem; }
  .row time { flex: 0 0 110px; font-family: var(--font-head); color: var(--muted); font-size: .9rem; }
  .row a { font-weight: 600; text-decoration: none; color: var(--green-900); }
  .row a:hover { color: var(--green-600); text-decoration: underline; }
  @media (max-width: 520px) { .row { flex-direction: column; gap: .15rem; } }
</style>
