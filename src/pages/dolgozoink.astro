---
import Page from '../layouts/Page.astro';
import { pedagogusok, segitok, technikai, type Person } from '../data/iskola';
const initials = (n: string) => n.replace(/^Dr\.\s*/, '').split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
const Group = (list: Person[], sun = false) => list;
---
<Page title="Dolgozóink" section="iskolank" lead="Pedagógusaink, a nevelő-oktató munkát közvetlenül segítő munkatársaink és technikai dolgozóink.">
  <h2>Pedagógusok</h2>
  <div class="grid grid-2" style="margin-bottom:2.5rem">
    {pedagogusok.map((p) => (
      <div class="card person">
        <span class="avatar">{initials(p.nev)}</span>
        <div>
          <div class="name">{p.nev}</div>
          <div class="role">{p.szak}</div>
          {p.extra && <div class="extra">{p.extra}</div>}
        </div>
      </div>
    ))}
  </div>
  <h2>Nevelő és oktató munkát közvetlenül segítő dolgozók</h2>
  <div class="grid grid-2" style="margin-bottom:2.5rem">
    {segitok.map((p) => (
      <div class="card person"><span class="avatar sun">{initials(p.nev)}</span><div><div class="name">{p.nev}</div><div class="role">{p.szak}</div></div></div>
    ))}
  </div>
  <h2>Technikai dolgozók</h2>
  <div class="grid grid-2">
    {technikai.map((p) => (
      <div class="card person"><span class="avatar sun">{initials(p.nev)}</span><div><div class="name">{p.nev}</div><div class="role">{p.szak}</div></div></div>
    ))}
  </div>
  <p style="margin-top:2rem"><a class="btn btn-primary" href="/fogadoorak/">Fogadóórák megtekintése</a></p>
</Page>
