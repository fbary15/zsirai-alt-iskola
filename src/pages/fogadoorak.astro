---
import Page from '../layouts/Page.astro';
import { fogadoorak, napokSorrend, iskola } from '../data/iskola';
const byDay = napokSorrend.map((nap) => ({ nap, list: fogadoorak.filter((f) => f.nap === nap).sort((a, b) => a.tol.localeCompare(b.tol, 'hu', { numeric: true })) }));
---
<Page title="Fogadóórák" section="iskolank" lead="Pedagógusaink fogadóórái. Kérjük, hogy előzetesen szíveskedjenek telefonon egyeztetni!">
  <div class="notice"><p>Időpont egyeztetés: <a href={iskola.telefonHref}><strong>{iskola.telefon}</strong></a> (iskolatitkárság)</p></div>
  <div class="days">
    {byDay.map((d) => (
      <section class="card day">
        <h3>{d.nap.charAt(0).toUpperCase() + d.nap.slice(1)}</h3>
        <ul class="list-clean">
          {d.list.map((f) => <li><span class="t">{f.tol}–{f.ig}</span><span class="n">{f.nev}</span></li>)}
        </ul>
      </section>
    ))}
  </div>
  <h2 style="margin-top:2.5rem">Névsor szerint</h2>
  <table class="table">
    <thead><tr><th>Pedagógus</th><th>Nap</th><th>Időpont</th></tr></thead>
    <tbody>{fogadoorak.map((f) => <tr><td>{f.nev}</td><td>{f.nap}</td><td>{f.tol} – {f.ig}</td></tr>)}</tbody>
  </table>
</Page>
<style>
  .days { display: grid; grid-template-columns: repeat(5, 1fr); gap: .8rem; }
  @media (max-width: 1100px) { .days { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .days { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .days { grid-template-columns: 1fr; } }
  .day { padding: 1.1rem 1.2rem; }
  .day h3 { font-size: 1rem; text-transform: uppercase; letter-spacing: .08em; color: var(--green-700); border-bottom: 2px solid var(--green-100); padding-bottom: .4rem; }
  .day li { display: flex; flex-direction: column; padding: .5rem 0; border-bottom: 1px solid var(--line); }
  .day li:last-child { border-bottom: 0; }
  .day .t { font-family: var(--font-head); font-weight: 700; color: var(--green-800); font-size: .95rem; }
  .day .n { font-size: .95rem; }
</style>
