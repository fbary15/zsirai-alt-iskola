---
import Base from '../layouts/Base.astro';
---
<Base title="Az oldal nem található">
  <div class="container page-body center" style="padding-block:6rem">
    <span class="eyebrow">404</span>
    <h1>Ez az oldal nem található</h1>
    <p class="muted" style="max-width:48ch;margin-inline:auto">Lehet, hogy a link elavult, vagy az oldal a régi honlapról még nem került át. Próbálja a címlapot vagy a híreket.</p>
    <div class="chip-row" style="justify-content:center;margin-top:1.5rem">
      <a class="btn btn-primary" href="/">Címlap</a>
      <a class="btn btn-outline" href="/hirek/">Hírek</a>
      <a class="btn btn-outline" href="/elerhetosegeink/">Elérhetőségeink</a>
    </div>
  </div>
</Base>
