---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NewsList from '../../components/NewsList.astro';
import { aktualisHirek, PAGE_SIZE } from '../../lib/util';
const total = Math.ceil(aktualisHirek.length / PAGE_SIZE);
const items = aktualisHirek.slice(0, PAGE_SIZE);
---
<Base title="Hírek" description="A Zsirai Általános Iskola aktuális hírei, eseményei, versenyeredményei.">
  <PageHero title="Hírek, események" lead={`Az iskola életének krónikája: versenyek, kirándulások, ünnepek és tudnivalók. Összesen ${aktualisHirek.length} bejegyzés.`}>
    <div class="chip-row" style="margin-top:1.25rem"><a class="chip" href="/archivum/">Régebbi bejegyzések az Archívumban →</a></div>
  </PageHero>
  <div class="container page-body">
    <NewsList items={items} page={1} total={total} base="/hirek/" />
  </div>
</Base>
