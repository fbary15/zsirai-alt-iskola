---
import Page from '../layouts/Page.astro';
import { partnerek } from '../data/iskola';
---
<Page title="Partnereink" section="iskolank" lead="Fenntartónk, önkormányzatunk, testvériskolánk és támogatóink, akikkel együtt dolgozunk a zsirai gyerekekért.">
  <div class="grid grid-2">
    {partnerek.map((p) => (
      <div class="card partner">
        {p.logo ? <div class="logo"><img src={p.logo} alt={p.nev} loading="lazy" /></div> : <div class="logo ph"><span>{p.nev.split(' ').slice(0, 2).map((w) => w[0]).join('')}</span></div>}
        <div>
          <strong>{p.nev}</strong>
          {p.cim && <div class="muted">{p.cim}</div>}
          {p.url && <a href={p.url} target="_blank" rel="noopener">{p.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a>}
        </div>
      </div>
    ))}
  </div>
</Page>
<style>
  .partner { padding: 1.25rem; display: flex; gap: 1.1rem; align-items: center; }
  .partner strong { font-family: var(--font-head); color: var(--green-900); display: block; }
  .logo { flex: 0 0 96px; width: 96px; height: 96px; border-radius: 12px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; padding: 8px; }
  .logo img { max-height: 80px; width: auto; object-fit: contain; }
  .logo.ph { background: var(--green-100); color: var(--green-800); font-family: var(--font-head); font-weight: 700; font-size: 1.4rem; }
  .partner a { font-size: .9rem; }
</style>
