---
import Page from '../layouts/Page.astro';
import { pages } from '../lib/util';
const p = pages['altalanos-ismerteto'];
---
<Page title="Általános ismertető" section="iskolank" lead="Nyolc évfolyamos általános iskola Zsirán – bemutatkozás, speciális tevékenységeink, személyi és tárgyi feltételeink.">
  <div class="stats">
    <div class="card stat"><strong>8</strong><span>évfolyamos általános iskola</span></div>
    <div class="card stat"><strong>1991</strong><span>óta jelenlegi formájában</span></div>
    <div class="card stat"><strong>12</strong><span>pedagógus, 98%-os szakos ellátottság</span></div>
    <div class="card stat"><strong>4</strong><span>tanterem interaktív táblával</span></div>
  </div>
  <div class="prose card" style="padding:clamp(1.25rem,4vw,2.5rem);max-width:none" set:html={p.html} />
</Page>
<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .stat { padding: 1.1rem 1.25rem; display: flex; flex-direction: column; }
  .stat strong { font-family: var(--font-head); font-size: 2rem; color: var(--green-700); line-height: 1; }
  .stat span { font-size: .9rem; color: var(--ink-2); margin-top: .3rem; }
</style>
