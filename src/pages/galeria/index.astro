---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { galeria } from '../../lib/util';
const albums = [...galeria].reverse();
const total = galeria.reduce((n, g) => n + g.images.length, 0);
---
<Base title="Galéria" description="Képgaléria a Zsirai Általános Iskola életéből: farsang, nyelvi napok, erdei iskola, pályaorientációs napok.">
  <PageHero title="Galéria" lead={`${albums.length} album, ${total} kép az iskola életéből.`} />
  <div class="container page-body">
    <div class="grid grid-3">
      {albums.map((a) => (
        <a class="card album" href={`/galeria/${a.slug}/`}>
          {a.cover ? <img src={a.images[0].thumb} alt="" width="640" height="480" loading="lazy" decoding="async" /> : <div style="background:var(--green-50);height:100%"></div>}
          <span class="cap">{a.title}<small>{a.images.length} kép{a.year ? ` · ${a.year}` : ''}</small></span>
        </a>
      ))}
    </div>
  </div>
</Base>
