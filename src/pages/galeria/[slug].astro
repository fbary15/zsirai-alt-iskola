---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { galeria } from '../../lib/util';

export function getStaticPaths() {
  return galeria.map((g) => ({ params: { slug: g.slug }, props: { album: g } }));
}
const { album } = Astro.props;
const idx = galeria.findIndex((g) => g.slug === album.slug);
const prev = galeria[idx + 1];
const next = galeria[idx - 1];
---
<Base title={album.title} description={`${album.title} – ${album.images.length} kép a Zsirai Általános Iskola galériájából.`} image={album.cover}>
  <PageHero title={album.title} lead={`${album.images.length} kép${album.year ? ` · ${album.year}` : ''}`} crumbs={[{ label: 'Galéria', href: '/galeria/' }]} />
  <div class="container page-body">
    <div class="masonry" id="gallery">
      {album.images.map((im, i) => (
        <a href={im.src} data-index={i} aria-label={`${i + 1}. kép megnyitása`}>
          <img src={im.thumb} alt={im.alt} width={im.w} height={im.h} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
        </a>
      ))}
    </div>
    <nav class="albnav">
      {prev ? <a class="btn btn-outline" href={`/galeria/${prev.slug}/`}>← {prev.title}</a> : <span></span>}
      <a class="btn btn-primary" href="/galeria/">Összes album</a>
      {next ? <a class="btn btn-outline" href={`/galeria/${next.slug}/`}>{next.title} →</a> : <span></span>}
    </nav>
  </div>

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Kép nagyítása">
    <button class="close" aria-label="Bezárás"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    <button class="prev" aria-label="Előző kép"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg></button>
    <img alt="" />
    <button class="next" aria-label="Következő kép"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg></button>
    <div class="count"></div>
  </div>
</Base>

<style>
  .albnav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#gallery a')];
  const lb = document.getElementById('lb')!;
  const img = lb.querySelector('img')!;
  const count = lb.querySelector('.count')!;
  let i = 0;
  const show = (n: number) => {
    i = (n + links.length) % links.length;
    img.src = links[i].href;
    img.alt = links[i].querySelector('img')?.alt ?? '';
    count.textContent = `${i + 1} / ${links.length}`;
  };
  const open = (n: number) => { show(n); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
  const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
  links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); open(n); }));
  lb.querySelector('.close')!.addEventListener('click', close);
  lb.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
  lb.querySelector('.next')!.addEventListener('click', () => show(i + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  let sx = 0;
  lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1); });
</script>
